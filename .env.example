# Proteção obrigatória. O simulador não inicia enquanto estiver false.
SIMULATOR_ENABLED=false
ACS_URL=http://demo.orbysync.tec.br:7547
ALLOWED_ACS_HOST=demo.orbysync.tec.br

# Credenciais CWMP. Copie este arquivo para .env e preencha somente no servidor.
ACS_USERNAME=
ACS_PASSWORD=

# Quantidade de CPEs por perfil. Use zero para desativar um fabricante.
ZTE_COUNT=5
VSOL_COUNT=5
DATACOM_COUNT=5
HUAWEI_COUNT=5

# Intervalo entre a inicialização de dispositivos para não gerar pico no ACS.
SPAWN_INTERVAL_MS=1000

